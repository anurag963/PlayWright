{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:framework": "playwright test -c tests/Framework",
    "test:framework:headed": "playwright test -c tests/Framework --headed",
    "report:framework": "playwright show-report playwright-report/framework",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:framework:allure": "rm -rf allure-results; playwright test -c tests/Framework; npm run allure:report",
    "test:api": "playwright test -c tests/ApiFramework",
    "report:api": "playwright show-report playwright-report/api",
    "allure:api:generate": "allure generate allure-results-api -o allure-report-api --clean",
    "allure:api:open": "allure open allure-report-api",
    "allure:api": "npm run allure:api:generate && npm run allure:api:open",
    "test:api:allure": "rm -rf allure-results-api; playwright test -c tests/ApiFramework; npm run allure:api",
    "bddgen": "bddgen -c tests/CucumberFramework",
    "test:cucumber": "bddgen -c tests/CucumberFramework && playwright test -c tests/CucumberFramework",
    "test:cucumber:headed": "bddgen -c tests/CucumberFramework && playwright test -c tests/CucumberFramework --headed",
    "report:cucumber": "playwright show-report playwright-report/cucumber",
    "allure:cucumber": "allure generate allure-results-cucumber -o allure-report-cucumber --clean && allure open allure-report-cucumber",
    "bddgen:api": "bddgen -c tests/ApiCucumberFramework",
    "test:api-cucumber": "bddgen -c tests/ApiCucumberFramework && playwright test -c tests/ApiCucumberFramework",
    "report:api-cucumber": "playwright show-report playwright-report/api-cucumber",
    "allure:api-cucumber:generate": "allure generate allure-results-api-cucumber -o allure-report-api-cucumber --clean",
    "allure:api-cucumber:open": "allure open allure-report-api-cucumber",
    "allure:api-cucumber": "npm run allure:api-cucumber:generate && npm run allure:api-cucumber:open",
    "test:api-cucumber:allure": "rm -rf allure-results-api-cucumber; npm run test:api-cucumber; npm run allure:api-cucumber",
    "test:hybrid": "playwright test -c tests/HybridFramework",
    "test:hybrid:headed": "playwright test -c tests/HybridFramework --headed",
    "report:hybrid": "playwright show-report playwright-report/hybrid",
    "allure:hybrid:generate": "allure generate allure-results-hybrid -o allure-report-hybrid --clean",
    "allure:hybrid:open": "allure open allure-report-hybrid",
    "allure:hybrid": "npm run allure:hybrid:generate && npm run allure:hybrid:open",
    "test:hybrid:allure": "rm -rf allure-results-hybrid; playwright test -c tests/HybridFramework; npm run allure:hybrid",
    "bddgen:hybrid": "bddgen -c tests/HybridCucumberFramework",
    "test:hybrid-cucumber": "bddgen -c tests/HybridCucumberFramework && playwright test -c tests/HybridCucumberFramework",
    "test:hybrid-cucumber:headed": "bddgen -c tests/HybridCucumberFramework && playwright test -c tests/HybridCucumberFramework --headed",
    "report:hybrid-cucumber": "playwright show-report playwright-report/hybrid-cucumber",
    "allure:hybrid-cucumber:generate": "allure generate allure-results-hybrid-cucumber -o allure-report-hybrid-cucumber --clean",
    "allure:hybrid-cucumber:open": "allure open allure-report-hybrid-cucumber",
    "allure:hybrid-cucumber": "npm run allure:hybrid-cucumber:generate && npm run allure:hybrid-cucumber:open",
    "test:hybrid-cucumber:allure": "rm -rf allure-results-hybrid-cucumber; npm run test:hybrid-cucumber; npm run allure:hybrid-cucumber"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anurag963/PlayWright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/anurag963/PlayWright/issues"
  },
  "homepage": "https://github.com/anurag963/PlayWright#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.22.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "playwright-bdd": "^9.2.1"
  }
}
